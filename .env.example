NODE_ENV=
CLINIQUE_PORT=

# Passerelle du CHU (origine seule) : service CHU, accueil, dossier patient
# et notifications passent tous par elle ; chaque prefixe est ajoute en code.
GATEWAY_URL=

# PostgreSQL partagé de la stack /opt/chu
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_SYNC=
DB_SSL=

# Frontends autorisés
SECURITY_CORS_ORIGINS=
GRAPHQL_PLAYGROUND_ENABLED=

# Sécurité interservices
# JWT_SECRET doit être identique à celui de auth-service.
JWT_SECRET=
# INTERNAL_API_KEY doit être identique dans les services concernés.
INTERNAL_API_KEY=
# Laisser false pendant la validation, puis passer à true en production.
AUTHZ_ENFORCE=
