NODE_ENV=development
CLINIQUE_PORT=3001
CLINIQUE_CONTAINER_NAME=clinique-service
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=sih
DB_PASSWORD=sih
DB_NAME=clinique
KAFKA_BROKERS=kafka:9092
SECURITY_PROFILE_HEADER=x-profile
SECURITY_ALLOWED_PROFILES=ONM,ONIM
SECURITY_CORS_ORIGINS=*
GRAPHQL_PLAYGROUND_ENABLED=false
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_CONTAINER_NAME=clinique-postgres
ZOOKEEPER_IMAGE=confluentinc/cp-zookeeper:7.6.1
ZOOKEEPER_CONTAINER_NAME=clinique-zookeeper
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000
KAFKA_IMAGE=confluentinc/cp-kafka:7.6.1
KAFKA_CONTAINER_NAME=clinique-kafka
KAFKA_PORT=9092
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
