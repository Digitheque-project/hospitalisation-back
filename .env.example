NODE_ENV=development

# === URLs des autres microservices ===
SERVICE_CHU_API_BASE_URL=
ACCUEIL_API_BASE_URL=
DOSSIER_PATIENT_API_BASE_URL=

# === Configuration du service Hospitalisation ===
# En local / Docker on utilise CLINIQUE_PORT.
# Sur Render, la plateforme injecte automatiquement la variable PORT.
CLINIQUE_PORT=3001
CLINIQUE_CONTAINER_NAME=clinique-service

# === Base de données (PostgreSQL) ===
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
# Laisser "false" en production : les migrations gèrent le schéma.
DB_SYNC=false
# Mettre "true" avec un hébergeur managed comme Neon (SSL obligatoire).
DB_SSL=false

# === Kafka (Event-Driven) - optionnel ===
KAFKA_BROKERS=
KAFKA_CLIENT_ID=

# === Sécurité ===
# Liste d'origines autorisées (CORS), séparées par des virgules. "*" = toutes.
SECURITY_CORS_ORIGINS=*

# === GraphQL ===
GRAPHQL_PLAYGROUND_ENABLED=false

# === Docker Configuration (local uniquement) ===
POSTGRES_IMAGE=
POSTGRES_CONTAINER_NAME=

ZOOKEEPER_IMAGE=
ZOOKEEPER_CONTAINER_NAME=
ZOOKEEPER_CLIENT_PORT=

KAFKA_IMAGE=
KAFKA_CONTAINER_NAME=
KAFKA_PORT=
KAFKA_BROKER_ID=
KAFKA_ZOOKEEPER_CONNECT=
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=
KAFKA_ADVERTISED_LISTENERS=
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=
KAFKA_AUTO_CREATE_TOPICS_ENABLE=

# ===== Authentification / Autorisation (JWT auth-service) =====
# DOIT etre identique au JWT_SECRET de auth-service (verification HS256).
JWT_SECRET=change-me-same-as-auth-service
# Cle partagee pour les appels service-a-service (ex: hospitalisation -> dossier-patient).
INTERNAL_API_KEY=change-me-internal-key
# false = mode audit (permissions tracees, non bloquantes). true = 403 si permission manquante.
AUTHZ_ENFORCE=false
