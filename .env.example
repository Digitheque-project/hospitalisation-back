NODE_ENV=
CLINIQUE_PORT=

# DNS internes Docker de la stack /opt/chu
# Convention: origine UNIQUEMENT (http://host:port), SANS segment de service ;
# chaque prefixe est integre dans le code :
#   - SERVICE_CHU_API_BASE_URL     -> le code ajoute /services (chu-api.config)
#   - ACCUEIL_API_BASE_URL         -> le code ajoute /accueil (accueil-api.config)
#   - DOSSIER_PATIENT_API_BASE_URL -> le code ajoute /dossier-patient (dossier-patient-api.config)
#   - NOTIFICATION_API_BASE_URL    -> aucun prefixe (routes a la racine)
SERVICE_CHU_API_BASE_URL=
ACCUEIL_API_BASE_URL=
DOSSIER_PATIENT_API_BASE_URL=
NOTIFICATION_API_BASE_URL=

# PostgreSQL partagé de la stack /opt/chu
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_SYNC=
DB_SSL=

# Frontends autorisés
SECURITY_CORS_ORIGINS=
GRAPHQL_PLAYGROUND_ENABLED=

# Sécurité interservices
# JWT_SECRET doit être identique à celui de auth-service.
JWT_SECRET=
# INTERNAL_API_KEY doit être identique dans les services concernés.
INTERNAL_API_KEY=
# Laisser false pendant la validation, puis passer à true en production.
AUTHZ_ENFORCE=
