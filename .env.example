NODE_ENV=development

# === URLs des autres microservices ===
SERVICE_CHU_API_BASE_URL=https://service-chu-back-production-77d5.up.railway.app
ACCUEIL_API_BASE_URL=https://acceuil-back.onrender.com

# === Configuration du service Hospitalisation ===
CLINIQUE_PORT=3001
CLINIQUE_CONTAINER_NAME=clinique-service

# === Base de données ===
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=sih
DB_PASSWORD=sih
DB_NAME=clinique
DB_SYNC=true

# === Kafka (Event-Driven) ===
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=hospitalisation-back

# === Sécurité ===
SECURITY_CORS_ORIGINS=*

# === GraphQL ===
GRAPHQL_PLAYGROUND_ENABLED=false

# === Docker Configuration ===
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_CONTAINER_NAME=clinique-postgres

ZOOKEEPER_IMAGE=confluentinc/cp-zookeeper:7.6.1
ZOOKEEPER_CONTAINER_NAME=clinique-zookeeper
ZOOKEEPER_CLIENT_PORT=2181

KAFKA_IMAGE=confluentinc/cp-kafka:7.6.1
KAFKA_CONTAINER_NAME=clinique-kafka
KAFKA_PORT=9092
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true